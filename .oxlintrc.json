{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json",
    "./node_modules/@aranlucas/oxforge/configs/nextjs.json",
    "./node_modules/@aranlucas/oxforge/configs/vitest.json",
    "./node_modules/@aranlucas/oxforge/configs/tailwind.json"
  ],
  "plugins": ["import", "jsx-a11y", "nextjs", "react", "typescript", "unicorn"],
  "env": {
    "browser": true,
    "node": true,
    "es2026": true
  },
  "options": {
    "typeAware": true
  },
  "settings": {
    "tailwindcss": {
      "entryPoint": "app/globals.css"
    }
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "rules": {
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "metadata",
          "viewport",
          "generateMetadata",
          "generateStaticParams",
          "dynamic",
          "revalidate",
          "alt",
          "size",
          "contentType",
          "runtime"
        ]
      }
    ],
    "eslint/no-console": [
      "error",
      {
        "allow": ["error", "warn"]
      }
    ],
    "vitest/consistent-test-filename": [
      "error",
      {
        "allTestPattern": "\\.(test|spec)\\.([cm]?[jt]s|[jt]sx)$",
        "pattern": "(^|[\\\\/])(tests[\\\\/]([^\\\\/]+[\\\\/])*[^\\\\/]+\\.test|e2e[\\\\/][^\\\\/]+\\.spec)\\.([cm]?[jt]s|[jt]sx)$"
      }
    ],
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ]
  }
}
