// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Add this line for ES Module compatibility
  moduleFormat    = "esm"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Recipe {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Core fields
  title       String
  slug        String  @unique
  description String?

  // Recipe content
  ingredients  Ingredient[]
  instructions Instruction[]

  // Metadata
  prepTime   Int? // minutes
  cookTime   Int? // minutes
  totalTime  Int? // minutes
  servings   String?
  difficulty Difficulty @default(MEDIUM)

  // Categorization
  cuisine String?
  course  Course?
  tags    Tag[]

  // Source tracking
  sourceUrl  String?
  sourceType SourceType

  // Media
  imageUrl String?
  images   RecipeImage[]

  // Search
  embedding  Unsupported("vector(768)")?
  searchText String? // Concatenated searchable text

  // User interaction
  notes      String?
  rating     Int? // 1-5
  isFavorite Boolean   @default(false)
  cookCount  Int       @default(0)
  lastCooked DateTime?

  // i18n
  locale       String              @default("en") // Original language of the recipe
  translations RecipeTranslation[]

  @@index([slug])
  @@index([cuisine])
  @@index([course])
  @@index([isFavorite])
  @@index([locale])
}

model Ingredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  quantity  String?
  unit      String?
  name      String
  notes     String? // "finely diced", "optional"
  group     String? // "For the sauce", "For the crust"
  sortOrder Int     @default(0)

  @@index([recipeId])
}

model Instruction {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  text      String
  group     String?
  sortOrder Int     @default(0)
  duration  Int? // minutes for this step
  imageUrl  String?

  @@index([recipeId])
}

model Tag {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  recipes Recipe[]
}

model RecipeImage {
  id        String  @id @default(cuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isPrimary Boolean @default(false)
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum Course {
  BREAKFAST
  LUNCH
  DINNER
  APPETIZER
  SIDE
  DESSERT
  SNACK
  DRINK
  SAUCE
  BREAD
}

enum SourceType {
  URL_IMPORT // Imported from external URL
  MANUAL // Manually entered
  NATURAL_LANGUAGE // Parsed from text/AI
  PHOTO // OCR from photo
  API // External recipe API
}

// i18n Translation Models
model RecipeTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  locale      String // ISO 639-1 language code (e.g., "es", "fr", "de", "ja")
  title       String
  description String?
  servings    String?
  notes       String?

  // Search text in translated language
  searchText String?

  // Relations
  ingredients  IngredientTranslation[]
  instructions InstructionTranslation[]

  @@unique([recipeId, locale])
  @@index([locale])
  @@index([recipeId])
}

model IngredientTranslation {
  id          String            @id @default(cuid())
  translationId String
  translation RecipeTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  // Reference to original ingredient for ordering
  originalIngredientId String

  name  String
  unit  String?
  notes String?
  group String?

  @@index([translationId])
}

model InstructionTranslation {
  id          String            @id @default(cuid())
  translationId String
  translation RecipeTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  // Reference to original instruction for ordering
  originalInstructionId String

  text  String
  group String?

  @@index([translationId])
}
