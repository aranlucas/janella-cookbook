# Database
DATABASE_URL="postgresql://user:pass@host:5432/cookbook?schema=public"

# Free-only recipe parsing, photo extraction, and chat via OpenRouter.
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_RECIPE_MODEL="dots-studio/dots-3-note-preview:free"
# Paid model IDs are ignored in favor of the free defaults. Free models can be rate limited.

# Optional hosted embeddings (may incur provider charges). Disabled by default;
# keyword search works without them.
ENABLE_HOSTED_EMBEDDINGS="false"
HUGGINGFACE_API_KEY=""

# Optional: Image storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="cookbook-images"

# Optional: Auth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
