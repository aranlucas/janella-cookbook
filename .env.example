# Database
DATABASE_URL="postgresql://user:pass@host:5432/cookbook?schema=public"
DATABASE_POOL_MAX="5"

# Recipe parsing, photo extraction, nutrition, and chat via the Railway FreeLLMAPI router.
# Create a dedicated client profile in the router's Keys > Unified API key tab.
FREELLM_API_KEY=""
FREELLM_BASE_URL="https://freellmapi-production-1175.up.railway.app/v1"
# auto follows the router's active chain, including provider fallback.
FREELLM_MODEL="auto"
# Recipe extraction prioritizes speed. Legacy "auto" also selects "auto:fast".
# Set a specific model or named router profile to override this preference.
FREELLM_RECIPE_MODEL="auto:fast"
# Hosted embeddings always use FreeLLMAPI with FREELLM_API_KEY.
# Pin EmbeddingGemma to preserve the existing 768-dimensional index.
FREELLM_EMBEDDING_MODEL="embeddinggemma-300m"

# Optional: Image storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="cookbook-images"

# Optional: Auth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Recipe MCP endpoint (/api/mcp). Required for all MCP access; use a random secret.
MCP_API_TOKEN=""

# Optional canonical site URL (a hostname or full URL).
NEXT_PUBLIC_SITE_URL=""
