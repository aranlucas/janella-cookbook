{
  "name": "janella-cookbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build",
    "railway-build": "railway run pnpm run build",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix --fix-suggestions",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrate:status": "prisma migrate status",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test:e2e": "playwright test",
    "test:deployment-auth": "vitest run tests/deployment-auth.test.mjs",
    "test:e2e:deployment": "playwright test --config playwright.deployment.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:search-projection": "vitest run tests/recipe-search-projection.test.ts",
    "test:mcp": "vitest run tests/recipe-mcp.test.ts",
    "embeddings:reindex": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import jiti/register scripts/reindex-embeddings.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.88",
    "@ai-sdk/openai-compatible": "^3.0.82",
    "@ai-sdk/react": "^4.0.163",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "ai": "^7.0.159",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.66.0",
    "mcp-handler": "^2.3.0",
    "nanoid": "^6.0.2",
    "neverthrow": "^8.2.0",
    "next": "^16.4.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.16.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "slugify": "^1.6.9",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "undici": "^8.12.3",
    "use-stick-to-bottom": "^1.1.6",
    "uuid": "^14.0.3",
    "vaul": "^1.1.2",
    "youtube-transcript": "^1.3.1",
    "youtubei.js": "^18.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^18.0.9",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tailwindcss": "^1.17.1",
    "oxlint-tsgolint": "^7.0.2005",
    "portless": "0.15.13",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.16.1"
}
