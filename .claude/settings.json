{
  "permissions": {
    "allow": [
      "mcp__playwright__execute",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run start:*)",
      "Bash(npm run db:studio:*)",
      "Bash(npm run db:generate:*)",
      "Bash(npm run db:migrate:status:*)",
      "Bash(npm install:*)",
      "Bash(npm list:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(railway env:*)",
      "Bash(ls:*)",
      "Bash(dir:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write .",
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  }
}
