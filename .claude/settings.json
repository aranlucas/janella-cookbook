{
  "permissions": {
    "allow": [
      "mcp__playwright__execute"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run format \"${filepath}\"",
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ]
  }
}
