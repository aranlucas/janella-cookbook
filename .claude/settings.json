{
  "permissions": {
    "allow": ["mcp__playwright__execute"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write $filepath",
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ]
  }
}
